<%#
  Uno Dos Cloud fork — ERP embed bridge.

  Lets the ERP shell (erp.tripwave.cloud) drive a Chatwoot embedded in an iframe:
  * theme       — ERP wins over prefers-color-scheme while embedded;
  * navigation  — Chatwoot's own sidebar is hidden, the ERP renders its menu and
                  asks this document to navigate;
  * menu        — the rendered sidebar (labels, paths, icons) is announced to the
                  parent, so the ERP copy cannot drift from this Chatwoot version.

  Design notes
  * Fully env-gated: the layout renders this partial only when
    ERP_EMBED_ALLOWED_ORIGINS is set, and the script re-checks window.parent's
    origin against that allowlist for every postMessage.
  * No build step / no imports: inline ES5 so it runs before the Vue bundles and
    survives Vite changes.
  * Menu is scraped from the rendered `aside a[href]` instead of reaching into
    Vue internals, so it keeps working across upstream versions (Chatwoot owns
    labels, translations, permissions and icons).

  Message contract (see docs/erp-embed.md):
    ERP → Chatwoot: erp:theme {dark}, erp:navigate {path}, erp:menu:refresh
    Chatwoot → ERP: chatwoot:ready {path}, chatwoot:menu {items}, chatwoot:route {path}
%>
<script>
  (function () {
    'use strict';

    var cfg = window.chatwootConfig || {};
    var allowed = String(cfg.erpEmbedAllowedOrigins || '')
      .split(',')
      .map(function (value) { return value.trim(); })
      .filter(Boolean);
    if (!allowed.length) return;

    var isAllowed = function (origin) { return allowed.indexOf(origin) !== -1; };

    var params = new URLSearchParams(window.location.search || '');
    var storage = window.localStorage;

    // ── embed detection ────────────────────────────────────────────────────
    // Embed mode is a property of the browsing context, never of storage: the
    // same origin serves both the ERP iframe and the standalone app, so a
    // persisted flag leaked into direct visits (their sidebar vanished).
    // Rule: inside a frame AND the parent proves it is the ERP (allowlisted
    // referrer, or the first valid erp:* message).
    var inFrame = window.self !== window.top;
    var embedParam = params.get('erp_embed');

    if (!inFrame || embedParam === '0') {
      // Standalone visit: Chatwoot owns its sidebar and theme. Nothing is
      // hidden, nothing is persisted, nothing is cleared.
      return;
    }

    var parentOrigin = null;
    try {
      if (document.referrer) {
        var referrerOrigin = new URL(document.referrer).origin;
        if (isAllowed(referrerOrigin)) parentOrigin = referrerOrigin;
      }
    } catch (e) { /* opaque referrer — wait for the first message */ }

    var send = function (payload) {
      if (!parentOrigin || window.parent === window) return;
      try { window.parent.postMessage(payload, parentOrigin); } catch (e) { /* ignore */ }
    };

    // ── theme + sidebar (embed mode only) ──────────────────────────────────
    // Chatwoot sets `dark` on <body> (dashboard) or <html> (v3 login) and reacts
    // to prefers-color-scheme. Inside the ERP iframe the shell owns the theme:
    // `__ERP_THEME_LOCK__` makes themeHelper.js and v3/App.vue stand down, and
    // the value is remembered (in this origin's storage) so a reload inside the
    // frame does not flash light. Standalone never reaches this code.
    var applyTheme = function (dark) {
      dark = !!dark;
      document.documentElement.classList.toggle('dark', dark);
      if (document.body) document.body.classList.toggle('dark', dark);
      document.documentElement.style.setProperty('color-scheme', dark ? 'dark' : 'light');
    };

    var embedApplied = false;

    var enableEmbed = function (origin) {
      if (embedApplied) return;
      embedApplied = true;
      if (origin) parentOrigin = origin;

      document.documentElement.classList.add('erp-embed');
      if (!document.getElementById('erp-embed-style')) {
        var style = document.createElement('style');
        style.id = 'erp-embed-style';
        style.textContent = 'html.erp-embed aside{display:none!important}';
        (document.head || document.documentElement).appendChild(style);
      }

      window.__ERP_THEME_LOCK__ = true;

      var storedTheme = storage.getItem('erp_theme');
      var themeParam = params.get('erp_theme');
      if (themeParam === 'dark' || themeParam === 'light') {
        storage.setItem('erp_theme', themeParam);
        storedTheme = themeParam;
      }
      applyTheme(storedTheme === 'dark');
    };

    // The referrer already proves the ERP parent: apply before first paint.
    if (parentOrigin) enableEmbed(null);

    // ── menu discovery ─────────────────────────────────────────────────────
    // Top-level sidebar entries as rendered for THIS user (permissions and
    // translations included). Nested channel lists are flattened by href.
    //
    // Icons: Chatwoot renders them as <span class="i-fluent-…"> (tailwindcss-icons
    // plugin), so there is no <svg> in the DOM — the glyph lives in an inline
    // SVG data-URI behind mask-image. Resolve it from the computed style, which
    // keeps the ERP copy identical to this Chatwoot version without hardcoding
    // an icon set. Falls back to a real <svg> if upstream ever switches.
    var svgFromComputedStyle = function (element) {
      try {
        var style = window.getComputedStyle(element);
        var raw = style.maskImage || style.webkitMaskImage || style.backgroundImage || '';

        // Tear off the outer url(...) wrapper only: iconify data-URIs carry
        // quotes inside (xmlns='…'), so a character class would truncate them.
        var wrapped = /^url\(([\s\S]*)\)$/.exec(raw.trim());
        var data = wrapped ? wrapped[1].replace(/^["']|["']$/g, '') : raw.trim();
        if (data.indexOf('data:image/svg+xml') !== 0) return null;

        var comma = data.indexOf(',');
        if (comma === -1) return null;

        var meta = data.slice(0, comma);
        var payload = data.slice(comma + 1);
        var svg = /;base64/i.test(meta) ? window.atob(payload) : decodeURIComponent(payload);
        return svg.indexOf('<svg') === -1 ? null : svg;
      } catch (e) {
        return null;
      }
    };

    var iconMarkup = function (link) {
      var svg = link.querySelector('svg');
      if (svg) return svg.outerHTML;

      var nodes = link.querySelectorAll('span');
      for (var i = 0; i < nodes.length; i += 1) {
        var markup = svgFromComputedStyle(nodes[i]);
        if (markup) return markup;
      }
      return null;
    };

    // Nearest group header for a leaf: Chatwoot renders groups as
    // li > button(header) + ul > li > a(leaf). Walking up to the closest <li>
    // that owns a <button> also flattens deeper nesting into the nearest group,
    // because the ERP renders two levels.
    var groupTriggerFor = function (link, aside) {
      var node = link.parentElement;
      var outermost = null;

      while (node && node !== aside) {
        if (node.tagName === 'LI') {
          // SidebarGroupHeader renders <div role="button" title="…">; other
          // layouts use a real <button>. The first match while walking up is
          // the nearest header, the last one is the top-level section — the ERP
          // shows two levels, so the outermost wins.
          // A group header is a non-navigating <div role="button" title="…">.
          // A header rendered as <a role="button"> IS the leaf itself and must
          // not become its own parent (that produced "Calls → Calls").
          var header = node.querySelector(':scope > div[role="button"][title], :scope > button');
          if (header) outermost = header;
        }
        node = node.parentElement;
      }

      return outermost;
    };

    var lastMenuJson = '';
    var scanMenu = function () {
      var aside = document.querySelector('aside');
      if (!aside) return false;

      var items = [];
      var groups = {};
      var seen = {};
      var links = aside.querySelectorAll('a[href]');

      for (var i = 0; i < links.length; i += 1) {
        var link = links[i];
        // Collapsed-sidebar popovers duplicate the same links.
        if (link.closest('[data-popover-content]')) continue;

        var href = link.getAttribute('href') || '';
        var label = (link.textContent || '').replace(/\s+/g, ' ').trim();
        if (!label || !href || href.charAt(0) === '#') continue;

        var external = /^https?:\/\//i.test(href);
        var path = href;
        if (!external) {
          try {
            var url = new URL(href, window.location.origin);
            path = url.pathname + url.search;
          } catch (e) { continue; }
        }

        // The search entry opens a modal, it is not a destination.
        if (!external && /\/search(\/|\?|$)/.test(path)) continue;

        var key = (external ? 'x:' : 'i:') + path;
        if (seen[key]) continue;
        seen[key] = true;

        var entry = {
          label: label,
          path: path,
          external: external,
          icon: iconMarkup(link)
        };

        var trigger = external ? null : groupTriggerFor(link, aside);
        if (!trigger) {
          items.push(entry);
          continue;
        }

        var groupLabel = (trigger.textContent || '').replace(/\s+/g, ' ').trim();
        var groupKey = 'g:' + groupLabel;
        var group = groups[groupKey];
        if (!group) {
          group = { label: groupLabel, icon: iconMarkup(trigger), children: [] };
          groups[groupKey] = group;
          items.push(group);
        }
        group.children.push(entry);
      }

      items = items
        .filter(function (item) {
          return !item.children || item.children.length > 0;
        })
        .map(function (item) {
          // "Мои Входящие → Мои Входящие": a group wrapping exactly one child
          // with the same label is just that leaf.
          if (
            item.children &&
            item.children.length === 1 &&
            item.children[0].label === item.label &&
            !item.children[0].children
          ) {
            return item.children[0];
          }
          return item;
        });

      var json = JSON.stringify(items);
      if (json !== lastMenuJson) {
        lastMenuJson = json;
        send({ type: 'chatwoot:menu', items: items });
      }
      return items.length > 0;
    };

    var readySent = false;
    var announce = function () {
      if (!readySent) {
        readySent = true;
        send({ type: 'chatwoot:ready', path: window.location.pathname });
      }
      scanMenu();
    };

    // ── route notifications ────────────────────────────────────────────────
    var notifyRoute = function () {
      send({ type: 'chatwoot:route', path: window.location.pathname + window.location.search });
    };
    ['pushState', 'replaceState'].forEach(function (method) {
      var original = history[method];
      history[method] = function () {
        var result = original.apply(this, arguments);
        notifyRoute();
        return result;
      };
    });
    window.addEventListener('popstate', notifyRoute);

    // ── ERP commands ───────────────────────────────────────────────────────
    var findLink = function (path) {
      var links = document.querySelectorAll('a[href]');
      for (var i = 0; i < links.length; i += 1) {
        var href = links[i].getAttribute('href') || '';
        if (href === path) return links[i];
        try {
          var url = new URL(href, window.location.origin);
          if (url.pathname + url.search === path) return links[i];
        } catch (e) { /* ignore */ }
      }
      return null;
    };

    window.addEventListener('message', function (event) {
      if (!isAllowed(event.origin)) return;
      if (window.parent !== event.source) return;

      // First contact (referrer was empty/opaque): replay what was scanned
      // before the parent origin was known, otherwise the menu would never
      // reach the ERP until something changes in the sidebar.
      var firstContact = !parentOrigin;
      parentOrigin = event.origin;
      // Opaque referrer: the parent is only proven now — switch embed mode on.
      enableEmbed(null);
      if (firstContact) {
        if (readySent) send({ type: 'chatwoot:ready', path: window.location.pathname });
        if (lastMenuJson) {
          try { send({ type: 'chatwoot:menu', items: JSON.parse(lastMenuJson) }); } catch (e) { /* ignore */ }
        }
      }

      var data = event.data || {};
      if (data.type === 'erp:theme') {
        applyTheme(data.dark);
        if (document.body) document.body.classList.toggle('dark', !!data.dark);
      } else if (data.type === 'erp:navigate' && typeof data.path === 'string' && data.path) {
        // Click the (hidden) router-link so the SPA does a client-side push;
        // fall back to a hard navigation for external/unmatched paths.
        var link = findLink(data.path);
        if (link) link.click();
        else window.location.assign(data.path);
      } else if (data.type === 'erp:menu:refresh') {
        lastMenuJson = '';
        scanMenu();
      }
    });

    // ── lifecycle ──────────────────────────────────────────────────────────
    var startScanning = function () {
      announce();
      var attempts = 0;
      var timer = window.setInterval(function () {
        attempts += 1;
        var found = scanMenu();
        if (found || attempts > 40) window.clearInterval(timer);
      }, 500);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startScanning);
    } else {
      startScanning();
    }

    // Re-scan when the sidebar re-renders (account switch, permission changes).
    if (window.MutationObserver) {
      var pending = null;
      var observer = new MutationObserver(function () {
        if (pending) return;
        pending = window.setTimeout(function () {
          pending = null;
          scanMenu();
          notifyRoute();
        }, 400);
      });
      document.addEventListener('DOMContentLoaded', function () {
        observer.observe(document.body, { childList: true, subtree: true });
      });
    }
  })();
</script>
